#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "zivid_camera_robot"
    doc = """Generated from Composed Stage of root layer /tmp/tmpmmky0ip5/zivid_camera_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_zivid_2_plus_mr130_isaac_fxohlnht/usdex_zivid_2_plus_mr130_isaac/zivid_camera_robot.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_zivid_2_plus_mr130_isaac_fxohlnht/temp_zivid_2_plus_mr130_isaac/zivid_2_plus_mr130_isaac.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "zivid_camera_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = </zivid_camera_robot/Physics/root_joint>
    prepend rel isaac:physics:robotLinks = </zivid_camera_robot/Geometry/zivid_base_link>
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "zivid_base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "zivid_optical_frame" (
                prepend apiSchemas = ["IsaacSiteAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

