    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "zivid_camera_robot"
{
    over "Geometry"
    {
        over "zivid_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </zivid_camera_robot>
            custom rel physics:body1
            prepend rel physics:body1 = </zivid_camera_robot/Geometry/zivid_base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

