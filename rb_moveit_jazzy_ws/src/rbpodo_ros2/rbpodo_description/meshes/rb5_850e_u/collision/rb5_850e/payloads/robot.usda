#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.2"
    }
    defaultPrim = "rb5_850e"
    doc = """Generated from Composed Stage of root layer /tmp/tmptkyisi7s/rb5_850e.usdc


