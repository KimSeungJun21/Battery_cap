"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "rb5_850e" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </rb5_850e/Physics/root_joint>,
        </rb5_850e/Physics/base>,
        </rb5_850e/Physics/shoulder>,
        </rb5_850e/Physics/elbow>,
        </rb5_850e/Physics/wrist1>,
        </rb5_850e/Physics/wrist2>,
        </rb5_850e/Physics/wrist3>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </rb5_850e/Geometry/link0>,
        </rb5_850e/Geometry/link0/link1>,
        </rb5_850e/Geometry/link0/link1/link2>,
        </rb5_850e/Geometry/link0/link1/link2/link3>,
        </rb5_850e/Geometry/link0/link1/link2/link3/link4>,
        </rb5_850e/Geometry/link0/link1/link2/link3/link4/link5>,
        </rb5_850e/Geometry/link0/link1/link2/link3/link4/link5/link6>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "link0" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link2" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link3" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link4" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "link5" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "link6" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "tcp" (
                                        prepend apiSchemas = ["IsaacSiteAPI"]
                                    )
                                    {
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "shoulder" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "elbow" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wrist2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
